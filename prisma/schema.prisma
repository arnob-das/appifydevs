generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PlanTier {
  FREE
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum ProviderType {
  OPENAI
  CLAUDE
  GEMINI
  CUSTOM
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id                    String        @id @default(uuid()) @db.Uuid
  email                 String        @unique
  passwordHash          String
  name                  String?
  avatarUrl             String?
  role                  Role          @default(USER)
  isEmailVerified       Boolean       @default(false)
  emailVerifyToken      String?
  emailVerifyExpires    DateTime?
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  sessions              Session[]
  subscription          Subscription?
  conversations         Conversation[]
  webSearches           WebSearch[]
  apiUsageLogs          ApiUsageLog[]

  @@index([email])
  @@index([role])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  isRevoked        Boolean   @default(false)
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @unique @db.Uuid
  planTier               PlanTier           @default(FREE)
  status                 SubscriptionStatus @default(ACTIVE)
  requestsUsedToday      Int                @default(0)
  requestsLimitDaily     Int                @default(20)
  tokensUsedCurrentMonth Int                @default(0)
  tokensLimitMonthly     Int                @default(100000)
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  lastResetDate          DateTime           @default(now())
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([planTier])
  @@index([status])
}

model AiProvider {
  id              String       @id @default(uuid()) @db.Uuid
  name            String       @unique
  providerType    ProviderType
  baseUrl         String?
  encryptedApiKey String
  defaultModel    String
  availableModels String[]     @default([])
  isEnabled       Boolean      @default(true)
  isDefault       Boolean      @default(false)
  priority        Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  conversations   Conversation[]

  @@index([providerType])
  @@index([isEnabled])
  @@index([isDefault])
}

model Conversation {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  title        String        @default("New Conversation")
  providerId   String?       @db.Uuid
  model        String?
  systemPrompt String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     AiProvider?   @relation(fields: [providerId], references: [id], onDelete: SetNull)
  messages     ChatMessage[]

  @@index([userId])
  @@index([providerId])
  @@index([createdAt])
}

model ChatMessage {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  role           MessageRole
  content        String       @db.Text
  tokensUsed     Int          @default(0)
  modelUsed      String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model WebSearch {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  query       String
  results     Json
  summary     String?  @db.Text
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([query])
  @@index([createdAt])
}

model SearchCache {
  id        String   @id @default(uuid()) @db.Uuid
  queryHash String   @unique
  query     String
  results   Json
  summary   String?  @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([queryHash])
  @@index([expiresAt])
}

model ApiUsageLog {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @db.Uuid
  endpoint       String
  method         String
  statusCode     Int
  responseTimeMs Int
  ipAddress      String?
  userAgent      String?
  tokensUsed     Int      @default(0)
  providerType   String?
  errorMessage   String?  @db.Text
  createdAt      DateTime @default(now())

  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([endpoint])
  @@index([statusCode])
  @@index([createdAt])
}
